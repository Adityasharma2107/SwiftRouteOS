# ==============================================================================
# SwiftRouteOS - Environment Configuration Template
# ==============================================================================

# Database Credentials & Connection
POSTGRES_DB=swiftroute_db
POSTGRES_USER=swiftroute
POSTGRES_PASSWORD=swiftroute_secret
DB_HOST=postgres
DB_PORT=5432

# Redis Cache Service
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Token Security (Base64 / Hex 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# SLA Engine Configuration
SLA_SCHEDULER_RATE_MS=30000
SLA_WARNING_THRESHOLD=0.70

# Container Host Ports
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_ALT_PORT=3000
