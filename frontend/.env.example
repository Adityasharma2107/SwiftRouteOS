# ==============================================================================
# SwiftRouteOS Frontend - Environment Variables Template
# When deploying to Vercel, set these in the Vercel Project Dashboard:
# ==============================================================================

# Your Spring Boot Backend API Base URL on Render (without trailing slash)
VITE_API_URL=https://swiftroute-backend.onrender.com/api

# Your Spring Boot Backend WebSocket Endpoint on Render (without trailing slash)
VITE_WS_URL=https://swiftroute-backend.onrender.com/ws
